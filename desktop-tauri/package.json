{
  "name": "@skillgate/desktop-tauri",
  "version": "0.6.0-team.1",
  "description": "Skillgate desktop app powered by React, Tauri 2, and Rust",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "build": "tauri build",
    "build:web": "tsc -b && vite build",
    "check": "bun run build:web && cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.10.1",
    "react": "19.1.5",
    "react-dom": "19.1.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "^26.1.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "^3.2.4"
  }
}
