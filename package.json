{
  "name": "skillgate-team",
  "private": true,
  "version": "0.1.0",
  "description": "Team skill catalog + skillgate CLI + OpenTUI + Electron GUI",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "cli",
    "ui",
    "desktop",
    "tui"
  ],
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "bootstrap:desktop": "node scripts/bootstrap.mjs --desktop",
    "setup": "node scripts/setup.mjs",
    "setup:desktop": "node scripts/setup.mjs --desktop",
    "build": "nx run skillgate:build",
    "build:all": "nx run-many -t build",
    "install-global": "nx run skillgate:build && node cli/bin/skillgate.mjs install-global",
    "smoke-test": "node cli/bin/skillgate.mjs smoke-test",
    "smoke-team": "bun run scripts/smoke-team-gui-tui.ts",
    "tui": "nx run @skillgate/tui:start",
    "tui:dev": "nx run @skillgate/tui:dev",
    "tui:window": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch-tui-window.ps1",
    "gui": "nx run @skillgate/desktop:dev",
    "gui:dev": "nx run @skillgate/desktop:dev",
    "gui:build": "nx run @skillgate/desktop:build",
    "gui:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-gui.ps1",
    "gui:window": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch-gui.ps1",
    "test": "nx run-many -t test",
    "test:desktop": "nx run @skillgate/desktop:test",
    "test:cli": "nx run skillgate:test",
    "graph": "nx graph"
  },
  "devDependencies": {
    "nx": "22.7.5"
  },
  "overrides": {
    "esbuild": "0.25.12"
  }
}