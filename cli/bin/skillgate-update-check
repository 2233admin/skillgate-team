#!/usr/bin/env bash
# skillgate-update-check — periodic version check for team-skills + skillgate CLI.
#
# Output (one line, or nothing):
#   TEAM_SKILLS_UPGRADE <local> <remote>  — team-skills VERSION differs from remote
#   SKILLGATE_UPGRADE <local> <remote>    — skillgate package version differs (npm/git)
#   (nothing)                             — up to date, snoozed, or check skipped
#
# Env overrides:
#   SKILLGATE_ROOT              — team-skills root (default: ~/.team-skills)
#   SKILLGATE_STATE_DIR         — state dir (default: ~/.skillgate)
#   SKILLGATE_TEAM_REMOTE_URL   — raw VERSION URL for team-skills
#   SKILLGATE_TEAM_REMOTE_REPO  — git URL for team-skills (ls-remote)
set -euo pipefail

TEAM_ROOT="${SKILLGATE_ROOT:-$HOME/.team-skills}"
STATE_DIR="${SKILLGATE_STATE_DIR:-$HOME/.skillgate}"
CACHE_FILE="$STATE_DIR/last-update-check"
SNOOZE_FILE="$STATE_DIR/update-snoozed"
TEAM_VERSION_FILE="$TEAM_ROOT/VERSION"
TEAM_REMOTE_URL="${SKILLGATE_TEAM_REMOTE_URL:-}"
TEAM_REMOTE_REPO="${SKILLGATE_TEAM_REMOTE_REPO:-}"

if [ "${1:-}" = "--force" ]; then
  rm -f "$CACHE_FILE" "$SNOOZE_FILE"
fi

# Throttle: at most once per 6 hours unless --force
if [ "${1:-}" != "--force" ] && [ -f "$CACHE_FILE" ]; then
  last="$(cat "$CACHE_FILE" 2>/dev/null || echo 0)"
  now="$(date +%s)"
  if [ $((now - last)) -lt 21600 ]; then
    exit 0
  fi
fi

mkdir -p "$STATE_DIR"
date +%s >"$CACHE_FILE"

if [ ! -f "$TEAM_VERSION_FILE" ]; then
  exit 0
fi

local_ver="$(tr -d '\r\n' <"$TEAM_VERSION_FILE")"

if [ -n "$TEAM_REMOTE_URL" ]; then
  remote_ver="$(curl -fsSL --max-time 5 "$TEAM_REMOTE_URL" 2>/dev/null | tr -d '\r\n' || true)"
  if [ -n "$remote_ver" ] && [ "$remote_ver" != "$local_ver" ]; then
    echo "TEAM_SKILLS_UPGRADE $local_ver $remote_ver"
    exit 0
  fi
elif [ -n "$TEAM_REMOTE_REPO" ] && command -v git >/dev/null 2>&1; then
  remote_ver="$(git ls-remote "$TEAM_REMOTE_REPO" HEAD 2>/dev/null | awk '{print substr($1,1,8)}' || true)"
  if [ -n "$remote_ver" ]; then
    local_hash="$(git -C "$TEAM_ROOT" rev-parse HEAD 2>/dev/null | awk '{print substr($1,1,8)}' || true)"
    if [ -n "$local_hash" ] && [ "$remote_ver" != "$local_hash" ]; then
      echo "TEAM_SKILLS_UPGRADE $local_hash $remote_ver"
      exit 0
    fi
  fi
fi

exit 0