{
  "name": "skillgate",
  "version": "0.6.0-team.1",
  "description": "Team skill distribution CLI (fork of skillsgate installer)",
  "type": "module",
  "exports": {
    "./team-api": "./dist/team-api/index.js"
  },
  "bin": {
    "skillgate": "./bin/skillgate.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "install-global": "node bin/skillgate.mjs install-global",
    "smoke-test": "node bin/skillgate.mjs smoke-test"
  },
  "keywords": [
    "ai",
    "agent",
    "skills",
    "team",
    "claude",
    "cursor",
    "codex",
    "grok"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "0.10.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@skillgate/ui": "*",
    "open": "10.1.2",
    "picocolors": "1.1.1",
    "simple-git": "3.36.0",
    "yaml": "2.9.0",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "esbuild": "0.25.12",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
